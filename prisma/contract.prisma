// use prisma-8

enum Role {
  SuperAdmin
  Admin
  Teacher
  User
}

model SuperAdmin {
  id           Int      @id @default(autoincrement())
  superAdminId String   @unique
  name         String
  email        String   @unique
  phoneNumber  String @unique
  password     String
  role         Role     @default(SuperAdmin)

  admins       Admin[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @onCreate(now()) @onUpdate(now())
}

model Admin {
  id           Int      @id @default(autoincrement())
  adminId      String   @unique
  name         String
  email        String   @unique
  phoneNumber  String @unique
  password     String
  role         Role     @default(Admin)

  superAdminId Int
  superAdmin   SuperAdmin @relation(
    fields: [superAdminId],
    references: [id],
    onDelete: Restrict
  )

  createdAt    DateTime @default(now())
  updatedAt    DateTime @onCreate(now()) @onUpdate(now())
}

model Teacher {
  id        Int      @id @default(autoincrement())
  teacherId String   @unique
  name      String
  email     String   @unique
  phoneNumber  String @unique
  password  String
  role      Role     @default(Teacher)

  createdAt DateTime @default(now())
  updatedAt DateTime @onCreate(now()) @onUpdate(now())
}
