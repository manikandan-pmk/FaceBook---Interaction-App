// use prisma-8

enum Role {
  Admin
  Teacher
}

enum PostStatus {
  Active
  Inactive
  Rejected
}

enum Status {
  Active 
  Inactive
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
}

model Admin {
  id            Int            @id @default(autoincrement())
  adminId       String         @unique
  name          String
  email         String         @unique
  phoneNumber   String         @unique
  password      String
  role          Role           @default(Admin)

  refreshTokens RefreshToken[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @onCreate(now()) @onUpdate(now())
}

model Teacher {
  id            Int            @id @default(autoincrement())
  teacherId     String         @unique
  name          String
  email         String         @unique
  phoneNumber   String         @unique
  password      String
  role          Role           @default(Teacher)
  status        Status  @default(Inactive)

  posts Post[]

  refreshTokens RefreshToken[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @onCreate(now()) @onUpdate(now())
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  jti         String   @unique
  tokenHash   String   @unique

  expiresAt   DateTime
  revokedAt   DateTime?

  adminId     Int?
  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  teacherId   Int?
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  userAgent   String?
  ipAddress   String?

  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([teacherId])
  @@index([expiresAt])
}

model Post {
  id String @id @onCreate(uuid())
  caption String?
  media String?
  type PostType @default(TEXT)
  likes Int @default(0)
  shares Int @default(0)
  status PostStatus @default(Inactive)
  views Int @default(0)
  createdAt  DateTime @default(now())
  updatedAt DateTime  @onCreate(now()) @onUpdate(now())

  teacherId String
  teacher Teacher @relation(fields:[teacherId],references:[teacherId],onDelete:Cascade)

@@index([teacherId])
@@index([createdAt])
@@index([type])
}


enum AdvertisementType {
  IMAGE
  GIF
  VIDEO
  YOUTUBE
}

model Advertisement {
  id String @id @onCreate(uuid())
  name        String
  description String?

  type        AdvertisementType
  mediaUrl    String            // Image, GIF, or uploaded video URL
  thumbnail   String?           // Optional video thumbnail

  isActive    Boolean           @default(false)
  displayOrder Int              @default(0)

  startDate   DateTime?
  endDate     DateTime?

  createdAt  DateTime @default(now())
  updatedAt DateTime  @onCreate(now()) @onUpdate(now())


  @@index([type])
  @@index([createdAt])
  @@index([displayOrder])
}